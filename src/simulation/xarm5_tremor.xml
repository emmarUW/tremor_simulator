<mujoco model="xarm5_tremor">
    <compiler angle="radian" meshdir="../../assets/meshes" autolimits="true" />
    <option integrator="RK4" timestep="0.001" gravity="0 0 -9.81">
        <flag energy="enable" contact="enable" />
    </option>

    <default>
        <joint damping="60" armature="1.0" />
        <geom contype="1" conaffinity="1" condim="3" friction="1 0.5 0.5" solref="0.02 1" solimp="0.9 0.95 0.001" />
        <position kp="500" forcelimited="true" forcerange="-100 100" />
    </default>

    <asset>
        <mesh name="link_base" file="xarm5/visual/link_base.stl" />
        <mesh name="link1" file="xarm5/visual/link1.stl" />
        <mesh name="link2" file="xarm5/visual/link2.stl" />
        <mesh name="link3" file="xarm5/visual/link3.stl" />
        <mesh name="link4" file="xarm5/visual/link4.stl" />
        <mesh name="link5" file="xarm5/visual/link5.stl" />
        
        <mesh name="gripper_base" file="gripper/base_link.stl" />
        <mesh name="left_finger" file="gripper/left_finger.stl" />
        <mesh name="right_finger" file="gripper/right_finger.stl" />

        <material name="silver" rgba="0.7 0.7 0.7 1" />
        <material name="black" rgba="0.1 0.1 0.1 1" />
    </asset>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1" />
        <geom type="plane" size="2 2 0.01" rgba="0.9 0.9 0.9 1" />

        <body name="base" pos="0 0 0">
            <geom type="mesh" mesh="link_base" material="black" />
            <body name="link1" pos="0 0 0.267">
                <joint name="joint1" axis="0 0 1" range="-6.28 6.28" />
                <geom type="mesh" mesh="link1" material="silver" />
                <body name="link2" pos="0 0 0" quat="0.7071 -0.7071 0 0">
                    <joint name="joint2" axis="0 0 1" range="-2.05 2.05" />
                    <geom type="mesh" mesh="link2" material="silver" />
                    <body name="link3" pos="0.0535 -0.2845 0">
                        <joint name="joint3" axis="0 0 1" range="-3.92 0.19" />
                        <geom type="mesh" mesh="link3" material="silver" />
                        <body name="link4" pos="0.0775 0.3425 0">
                            <joint name="joint4" axis="0 0 1" range="-1.69 3.14" />
                            <geom type="mesh" mesh="link4" material="silver" />
                            <body name="link5" pos="0.076 0.097 0" quat="0.7071 -0.7071 0 0">
                                <joint name="joint5" axis="0 0 1" range="-1.69 3.14" />
                                <geom type="mesh" mesh="link5" material="silver" />
                                
                                <!-- Gripper mounting: Zero offset, 180deg Z flip per official xarm_description -->
                                <body name="gripper_base" pos="0 0 0" quat="0 0 0 1">
                                    <geom type="mesh" mesh="gripper_base" material="black" />
                                    <!-- Finger positions derived from xarm_gripper.urdf.xacro: -->
                                    <!-- Knuckle offset (0.035) + Finger joint offset (0.035465) = ~0.0705 -->
                                    <!-- Z height: Knuckle (0.059) + Finger joint (0.042) = ~0.101 -->
                                    <body name="left_finger" pos="0 0.0705 0.101">
                                        <joint name="drive_joint" axis="0 -1 0" range="0 0.05" type="slide" damping="15" />
                                        <geom type="mesh" mesh="left_finger" material="silver" />
                                    </body>
                                    <body name="right_finger" pos="0 -0.0705 0.101">
                                        <joint name="right_finger_joint" axis="0 1 0" range="0 0.05" type="slide" damping="15" />
                                        <geom type="mesh" mesh="right_finger" material="silver" />
                                    </body>
                                    <site name="tcp" pos="0 0 0.172" size="0.01" rgba="1 0 0 1" />
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position name="a1" joint="joint1" />
        <position name="a2" joint="joint2" />
        <position name="a3" joint="joint3" />
        <position name="a4" joint="joint4" />
        <position name="a5" joint="joint5" />
        <position name="gripper" joint="drive_joint" kp="300" forcerange="-30 30" />
    </actuator>

    <equality>
        <joint joint1="drive_joint" joint2="right_finger_joint" polycoef="0 1 0 0 0" />
    </equality>

    <contact>
        <!-- Expanded collision exclusions to allow zero-offset mounting -->
        <exclude body1="link5" body2="gripper_base" />
        <exclude body1="link5" body2="left_finger" />
        <exclude body1="link5" body2="right_finger" />
        <exclude body1="gripper_base" body2="left_finger" />
        <exclude body1="gripper_base" body2="right_finger" />
    </contact>
</mujoco>
